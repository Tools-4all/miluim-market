// כללי האבטחה של Firestore.
// הקוד של האתר גלוי לכולם, אז מי שרוצה יכול לשלוח בקשות ישר ל-Firebase.
// הכללים האלה רצים בשרת של Firebase ומחליטים מה מותר - הם ההגנה האמיתית.
//
// request.auth          = המשתמש ששלח את הבקשה (null אם לא מחובר)
// resource.data         = המסמך כמו שהוא עכשיו במסד הנתונים
// request.resource.data = המסמך כמו שהוא יהיה אחרי השינוי
//
// את הקובץ הזה מעתיקים ל-Firebase Console > Firestore > Rules ולוחצים Publish.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // משתמשים: כולם יכולים לראות פרופיל, רק אני יכול לשנות את שלי
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // מודעות: כולם יכולים לראות.
    // לפרסם - רק משתמש מחובר, ורק בשם של עצמו.
    // לערוך או למחוק - רק מי שפרסם.
    match /listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.sellerId == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.sellerId == request.auth.uid
                    && request.resource.data.sellerId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.sellerId == request.auth.uid;

      // תגובות: כולם רואים, משתמש מחובר מגיב בשם עצמו.
      // למחוק: מי שכתב את התגובה, או בעל המודעה (כשהוא מוחק את המודעה כולה).
      // get(...) קורא את מסמך המודעה מתוך הכללים, כדי לבדוק מי בעל המודעה.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.resource.data.authorId == request.auth.uid;
        allow delete: if request.auth != null
                      && (resource.data.authorId == request.auth.uid
                          || get(/databases/$(database)/documents/listings/$(listingId)).data.sellerId == request.auth.uid);
      }
    }

    // שיחות פרטיות: רק שני המשתתפים (הקונה והמוכר) יכולים לראות ולכתוב.
    // participants = מערך עם ה-uid של שניהם.
    match /chats/{chatId} {
      // resource == null - מאפשר לבדוק אם שיחה קיימת לפני שהיא נוצרה
      allow read: if request.auth != null
                  && (resource == null || request.auth.uid in resource.data.participants);
      // רק הקונה פותח שיחה, ורק כשהוא אחד המשתתפים
      allow create: if request.auth != null
                    && request.resource.data.buyerId == request.auth.uid
                    && request.auth.uid in request.resource.data.participants;
      // משתתף יכול לעדכן (הודעה אחרונה), אבל לא לשנות מי משתתף
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null
                      && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
  }
}
